{
  "name": "resume-terminal-studio",
  "private": true,
  "version": "0.2.0",
  "description": "Local resume editing workbench with Electron, terminal visibility, and AI-reviewed patch flow.",
  "author": "Xu Qiwang",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:bridge": "node bridge/server.js",
    "mcp": "node bridge/mcp-server.cjs",
    "ingest": "node bridge/bin/ingest.cjs",
    "demo:reset": "node demo/scripts/reset-demo.mjs",
    "demo:patch": "node demo/scripts/propose-demo-patch.mjs",
    "demo:write-patch": "node demo/scripts/write-demo-pending.mjs",
    "demo:render-video": "./node_modules/electron/dist/Electron.app/Contents/MacOS/Electron demo/scripts/render-stage-video.cjs",
    "test": "node bridge/workspacePath.test.cjs && node bridge/core/core.test.cjs && node bridge/bin/auth.test.cjs && node bridge/bin/ingest.test.cjs && node bridge/bin/pending-patch.test.cjs && node bridge/mcp-server.test.cjs && node bridge/contextStore.test.mjs && node bridge/historyStore.test.mjs && node bridge/fileStoreSecurity.test.mjs && node bridge/serverDocumentFlow.test.mjs && node src/lib/fileClient.test.mjs && node src/templates/professional/layout.test.cjs && node electron/bridgeRuntime.test.cjs",
    "dev:all": "concurrently \"npm:dev:bridge\" \"npm:dev -- --host 127.0.0.1 --port 4173\"",
    "dev:desktop": "concurrently \"npm:dev -- --host 127.0.0.1 --port 4173\" \"npm:electron\"",
    "electron": "npx wait-on tcp:4173 && ./node_modules/electron/dist/Electron.app/Contents/MacOS/Electron .",
    "build": "vite build",
    "site:build": "node site/scripts/build.mjs",
    "preview": "vite preview",
    "build:desktop": "vite build && electron-builder",
    "install:desktop": "node tools/install-desktop.mjs"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "vite": "^7.1.0",
    "wait-on": "^8.0.1"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "studio.resume.terminal",
    "productName": "Resume Studio",
    "asar": true,
    "asarUnpack": [
      "bridge/bin/**/*"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "bridge/**/*",
      "!bridge/**/*.test.cjs",
      "!bridge/**/*.test.mjs",
      "!electron/**/*.test.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dir",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity"
    },
    "extraResources": [
      {
        "from": "bridge",
        "to": "bridge",
        "filter": [
          "**/*",
          "!**/*.test.cjs",
          "!**/*.test.mjs"
        ]
      },
      {
        "from": "workspace-template",
        "to": "workspace",
        "filter": [
          "active-resume.json"
        ]
      }
    ]
  },
  "allowScripts": {}
}
